
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}



model Blog {
blog_id           String @id @default (uuid())
blog_cover_url    String
blog_title        String
blog_description  String
blog_tags         String
blog_author_name  String
blog_author_url   String
blog_content      String?
created_at        DateTime @default (now())
updated_at        DateTime @updatedAt
}